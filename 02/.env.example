# 複製成 .env 後依需求修改。.env 已被 .gitignore 排除。

# 環境：development | test | production
APP_ENV=development

# 資料庫檔案路徑。
# 留空則使用使用者資料目錄，避免放在 OneDrive 等雲端同步資料夾造成 SQLite 檔案損毀：
#   Windows    -> %LOCALAPPDATA%\school-mvp\development.db
#   Linux/macOS-> ~/.local/share/school-mvp/development.db
# 也可以明確指定：
# DB_PATH=./data/development.db
# 測試用（記憶體資料庫，每次啟動都是全新 schema）：
# DB_PATH=:memory:

# JWT 簽章金鑰，長度至少 32 字元。正式環境必填，否則啟動會直接報錯。
# 產生方式：deno eval 'console.log(crypto.randomUUID()+crypto.randomUUID())'
JWT_SECRET=dev-only-insecure-jwt-secret-please-change-me

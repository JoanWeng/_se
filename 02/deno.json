{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "vite",
    "build": "vite build",
    "start": "deno run -A scripts/serve.ts",
    "update": "deno run -A -r jsr:@fresh/update .",
    "db:migrate": "deno run -A scripts/migrate.ts",
    "db:seed": "deno run -A scripts/seed.ts",
    "db:reset": "deno run -A scripts/seed.ts --reset",
    "test": "deno test -A"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "fmt": {
    "exclude": [
      "*.md"
    ]
  },
  "exclude": [
    "**/_fresh/*",
    "scripts/serve.ts"
  ],
  "imports": {
    "@/": "./",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/http": "jsr:@std/http@^1.1.4",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@types/node": "npm:@types/node@^26.6.3",
    "@zaubrik/djwt": "jsr:@zaubrik/djwt@^3.0.2",
    "bcryptjs": "npm:bcryptjs@^3.0.3",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "zod": "npm:zod@^4.6.5"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
